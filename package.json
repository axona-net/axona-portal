{
  "name": "axona-portal",
  "version": "0.4.0",
  "private": false,
  "description": "Drag a file in, it arrives on someone else's desktop. A small Axona file portal that runs on your own machine.",
  "type": "module",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.mjs",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "@axona/protocol": "github:axona-net/axona-protocol#v4.49.0",
    "node-datachannel": "^0.32.3",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "net.axona.portal",
    "productName": "axona.portal",
    "files": [
      "main/**",
      "preload/**",
      "renderer/**",
      "src/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-datachannel/**"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "identity": null
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "linux": {
      "category": "Utility",
      "target": ["AppImage"]
    }
  }
}
